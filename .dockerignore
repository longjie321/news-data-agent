# ============================================================
# 【这个文件干什么】
#   告诉 docker build "哪些东西不要打进镜像"。
#
# 【为什么必须有它】
#   .venv 有几百 MB，是给本机用的虚拟环境，容器里会自己装依赖，
#   打进去既浪费镜像体积又可能和容器内的 Python 冲突。
#   同理 .env 里有密钥，绝不能进镜像（那等于把 key 公开了）。
# ============================================================

# 本机虚拟环境（容器自己会装依赖）
.venv/
venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 密钥、配置（运行时用 --env-file 传进去，不打包）
.env

# git 和 IDE 配置
.git/
.idea/
.vscode/

# 临时文件和日志
*.log
*.bak

# 文档和测试（镜像里跑不到，去掉能减小体积）
README.md
pytest.ini
tests/
