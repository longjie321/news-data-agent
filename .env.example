# 把这个文件复制一份改名为 .env，然后填上真实值
# （.env 不要提交到 git）

# DeepSeek 的 key —— 可以和项目1 用同一个
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 数据库 —— 密码填你本机 MySQL 的密码（和项目1 用的同一个）
# 库名 news_agent 不用先建，跑 scripts/init_db.py 会自动建
DB_URL=mysql+aiomysql://root:你的密码@127.0.0.1:3306/news_agent

# 新闻数据源 —— 天聚数行（https://www.tianapi.com/）
# 注册 + 实名认证 + 申请接口后，在「个人中心 → 我的密钥」复制 APIKEY
NEWS_API_KEY=在这里填天聚数行的APIKEY
# 接口的基础地址（一般不用改，具体抓哪几个接口在 config/news_conf.py 里配）
NEWS_API_BASE=http://api.tianapi.com
